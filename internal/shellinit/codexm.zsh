# Generated by codexm shell-init zsh. Only codexm is a function; codex stays native.
# Retire only our old account wrapper when reloading an existing terminal.
if (( $+functions[codex] )) && [[ "${functions[codex]}" == *codex-accounts* || "${functions[codex]}" == *_CODEX_ACCOUNT_HELPER* ]]; then
  unfunction codex
fi
for _codexm_retired in codex_account codex_auth codex_auth_status codex_auth_save; do
  unfunction "$_codexm_retired" 2>/dev/null || true
done
unset _codexm_retired
function codexm() {
  emulate -L zsh
  local _codexm_dir _codexm_exit=0
  _codexm_dir=$(command mktemp -d "${TMPDIR:-/tmp}/codexm-shell.XXXXXXXXXX") || return $?
  {
    # Do not capture stdout: browser/device login retains its terminal and streams.
    if CODEXM_SHELL_RESULT="$_codexm_dir/result" command codexm "$@"; then
      _codexm_exit=0
    else
      _codexm_exit=$?
    fi
    if (( _codexm_exit == 0 )) && [[ -e "$_codexm_dir/result" || -L "$_codexm_dir/result" ]]; then
      local _codexm_magic _codexm_name _codexm_home _codexm_shared _codexm_extra=''
      if [[ -f "$_codexm_dir/result" && ! -L "$_codexm_dir/result" && -O "$_codexm_dir/result" ]] && {
        IFS= read -r -d $'\0' _codexm_magic &&
        IFS= read -r -d $'\0' _codexm_name &&
        IFS= read -r -d $'\0' _codexm_home &&
        IFS= read -r -d $'\0' _codexm_shared &&
        ! IFS= read -r -d $'\0' _codexm_extra && [[ -z "$_codexm_extra" ]]
      } < "$_codexm_dir/result" &&
        [[ "$_codexm_magic" == codexm-native-account-v1 &&
           "$_codexm_name" == [A-Za-z0-9]* && "$_codexm_name" != *[^A-Za-z0-9_-]* &&
           ${#_codexm_name} -le 64 && "$_codexm_name" != default &&
           "$_codexm_home" == /* && "$_codexm_shared" == /* &&
           "${(t)CODEX_ACCOUNT}${(t)CODEX_HOME}${(t)CODEX_SQLITE_HOME}${(t)CODEX_SHARED_HOME}${(t)CODEX_ACCOUNTS_DIR}" != *readonly* ]]; then
        export CODEX_ACCOUNT="$_codexm_name" CODEX_HOME="$_codexm_home" \
          CODEX_SQLITE_HOME="$_codexm_shared" CODEX_SHARED_HOME="$_codexm_shared" \
          CODEX_ACCOUNTS_DIR="${_codexm_home:h}"
        print -r -- "Native Codex account for this terminal: $_codexm_name. Native default and running Codex sessions were preserved."
      else
        print -ru2 -- 'codexm: could not apply shell account selection; the terminal environment was preserved.'
        _codexm_exit=1
      fi
    fi
  } always {
    command rm -f -- "$_codexm_dir/result"
    command rmdir -- "$_codexm_dir"
  }
  return $_codexm_exit
}
