{
	admin off
	persist_config off
	email {$CODEXM_CERT_EMAIL}
	storage file_system {
		root {$CODEXM_TLS_STORAGE}
	}
	log {
		output file {$CODEXM_HTTPS_LOG} {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 168h
		}
	}
}

https://{$CODEXM_PUBLIC_HOST} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	reverse_proxy 127.0.0.1:4317 {
		header_up X-Codexm-Client-IP {remote_host}
	}
}
